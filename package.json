    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "pix-utils": "^2.8.2",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=22.5.0"
  }
