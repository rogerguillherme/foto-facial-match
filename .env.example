# Copie para .env e preencha antes de rodar em produção.

PORT=3000

# Connection string do Postgres (Neon/Vercel Postgres/Supabase). Na Vercel,
# a integração injeta isso automaticamente como env var do projeto — só é
# preciso preencher aqui pra rodar localmente contra o mesmo banco.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Segredo para assinar os tokens JWT do fotógrafo. Gere um valor aleatório forte.
JWT_SECRET=troque-este-valor-para-um-segredo-aleatorio

# Provedor de reconhecimento facial: "mock" (padrão, offline, para dev/teste)
# ou "rekognition" (AWS Rekognition, ver credenciais abaixo).
FACE_PROVIDER=mock

# Só necessário quando FACE_PROVIDER=rekognition
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Nome da "collection" do Rekognition usada como índice de rostos do catálogo.
REKOGNITION_COLLECTION_ID=foto-facial-match

# Limiar mínimo de confiança (0-100) para considerar uma foto como "match" da selfie.
FACE_MATCH_THRESHOLD=80

# Storage de mídia: Cloudflare R2 (API S3). Bucket com acesso público de leitura
# (domínio r2.dev ou domínio próprio) e CORS liberando PUT do domínio do app.
# Sem estas variáveis o app sobe, mas upload/preview falham com erro claro.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pública do bucket, sem barra final (ex.: https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=
